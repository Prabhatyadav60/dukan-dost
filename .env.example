# Copy to .env. Everything has a working default; this runs with no .env at all (fake AI, in-memory DB).
MONGO_URI=memory                 # or mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_DB=dukan_dost
AI_PROVIDER=fake                 # live = real Claude
LLM_BACKEND=anthropic            # anthropic | bedrock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AWS_REGION=ap-south-1            # bedrock only
BEDROCK_MODEL_ID=
AWS_BEARER_TOKEN_BEDROCK=
SARVAM_API_KEY=                  # set → real speech-to-text
JWT_SECRET=change-me-32-bytes-minimum
JWT_TTL_MINUTES=720
DEMO_PHONE=+919999900001
DEMO_OTP=123456
DEMO_TODAY=2026-10-31            # fixed "today" so the demo numbers repeat; empty = real clock
DEMO_CUSTOMER_PHONES=            # comma-separated: Sharma, Gupta, Verma, Anil (teammates' WhatsApp)
PUBLIC_WEB_URL=http://localhost:5173   # base of pay links — your HTTPS tunnel URL for phones
WEB_ORIGIN=http://localhost:5173
PAYMENT_WEBHOOK_SECRET=change-me-32-bytes-minimum
PAY_LINK_TTL_HOURS=72
UPLOAD_DIR=./data/uploads
AI_RATE_LIMIT_PER_MIN=20
FEATURE_SHELF_SCAN=false
FORECAST_MARGIN=0.10
# web (apps/web/.env): VITE_API_BASE_URL=http://localhost:8000
